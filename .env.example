# ─── HantsLocal environment ───────────────────────────────────────────────
# Copy to .env and fill in. Only DATABASE_URL is required for Phases 0–1.
# Integration keys (Places/SerpAPI) are optional — adapters fall back to mock
# mode when a key is absent, so discovery/enrichment are runnable without them.

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# From-address for all outbound email (must be a verified Brevo sender)
EMAIL_FROM="hello@hantslocal.co.uk"

# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgres://hantslocal:hantslocal@localhost:5432/hantslocal"

# ─── Phase 2: discovery + enrichment ──────────────────────────────────────
# Google Places API (New) — Text Search + Place Details
PLACES_API_KEY=""
# SerpAPI — Google Local engine for 3-pack rank
SERPAPI_KEY=""
# Puppeteer: path to a system Chromium/Chrome for live crawls.
# Left blank → crawl adapter runs in mock mode (no browser launched).
PUPPETEER_EXECUTABLE_PATH=""
# Shared secret required in the X-Worker-Secret header on /api/workers/* routes
N8N_WEBHOOK_SECRET="change-me-dev-secret"

# ─── Later phases (placeholders so Coolify wiring is documented) ───────────
# Phase 3 — Brevo transactional + campaigns
BREVO_API_KEY=""
# Admin allowlist — comma-separated emails that may access /admin.
# Unset in production = no admin access (fail closed). Open in dev when unset.
ADMIN_EMAILS=""

# Phase 4 — Stripe + Auth.js
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PREMIUM=""
AUTH_SECRET=""
# Phase 4 — Cloudflare R2 (owner photo uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Phase 5 — Google Business Profile OAuth (premium review import)
GBP_CLIENT_ID=""
GBP_CLIENT_SECRET=""
